<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.service-switchboard" path="/org/gnome/shell/extensions/service-switchboard/">
    <key name="services-json" type="s">
      <default>'[]'</default>
      <summary>Configured services</summary>
      <description>JSON representation of services shown in the panel menu.</description>
    </key>
    <key name="refresh-interval" type="u">
      <range min="2" max="300"/>
      <default>10</default>
      <summary>Refresh interval</summary>
      <description>Number of seconds between service status checks.</description>
    </key>
  </schema>
</schemalist>
